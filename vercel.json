{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/pilot-site/(.*)",
      "destination": "/pilot-site/$1"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    }
  ],
  "headers": [
    {
      "source": "/pilot-site/(.*)",
      "headers": {
        "Cache-Control": "public, max-age=60, s-maxage=300"
      }
    },
    {
      "source": "/assets/(.*)",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      }
    }
  ]
}